# 复制为 .env 后填写，docker compose 自动读取
FOODTRACE_JWT_SECRET=change-me-to-a-random-secret-of-32-bytes-or-longer
FOODTRACE_DB_PASSWORD=123456

# 默认经 host.docker.internal 访问宿主机/WSL 内的 MySQL、WeBASE-Sign 与节点
# 如端口转发已就绪（见 README）无需修改

# MinIO 与后端默认共用这些凭据；部署时替换演示值
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 外部对象存储可另外设置 FOODTRACE_STORAGE_ENDPOINT / ACCESS_KEY / SECRET_KEY

# 换环境部署后填写对应地址；锚定地址为空表示尚未启用锚定
FOODTRACE_CONTRACT_ADDRESS=0x2af6160e266f763652f433a80b94fc13f4065303
FOODTRACE_ANCHOR_ADDRESS=

# 新库无需基线；旧库须按 README 核对结构后，仅首次接管时启用
FOODTRACE_DB_BASELINE=false
FOODTRACE_DB_BASELINE_VERSION=1
