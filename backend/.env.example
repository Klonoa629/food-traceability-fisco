# 后端启动所需环境变量示例（复制并替换为实际值）
# JWT 签名密钥：HS256，至少 32 字节的随机串，例如 openssl rand -base64 32 的输出
FOODTRACE_JWT_SECRET=please-replace-with-a-random-secret-of-32-bytes-or-longer
# MySQL 密码（foodtrace 库所在实例，见 application.yaml 的 spring.datasource）
FOODTRACE_DB_PASSWORD=replace-with-your-database-password
# 新环境必须设置自己的合约地址，不使用 application.yaml 保留的本机默认地址
# FOODTRACE_CONTRACT_ADDRESS=0x...
# 可选：留空关闭审计锚定；启用时由同一监管身份部署 AuditAnchor
FOODTRACE_ANCHOR_ADDRESS=
# 存储凭据须与实际 MinIO 实例一致
FOODTRACE_STORAGE_ENDPOINT=http://127.0.0.1:9000
FOODTRACE_STORAGE_ACCESS_KEY=replace-with-your-storage-user
FOODTRACE_STORAGE_SECRET_KEY=replace-with-your-storage-password