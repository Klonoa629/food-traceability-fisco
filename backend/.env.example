# 后端启动所需环境变量示例（复制并替换为实际值）
# JWT 签名密钥：HS256，至少 32 字节的随机串，例如 openssl rand -base64 32 的输出
FOODTRACE_JWT_SECRET=please-replace-with-a-random-secret-of-32-bytes-or-longer
# MySQL 密码（foodtrace 库所在实例，见 application.yaml 的 spring.datasource）
FOODTRACE_DB_PASSWORD=123456
# 可选：合约地址（默认见 application.yaml，重新部署合约后覆盖）
# FOODTRACE_CONTRACT_ADDRESS=0x...
